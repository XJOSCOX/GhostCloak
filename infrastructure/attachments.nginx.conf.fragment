# MANUAL REVIEW ONLY. Include inside the existing PRIVATE Ghost Cloak nginx server.
# Keep its tunnel/Unix-socket listener, firewall and public hostname unchanged.
location ^~ /v1/attachments {
    client_max_body_size 26m;
    client_body_timeout 660s;
    send_timeout 660s;
    access_log off;
    error_log /dev/null;
    autoindex off;
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header CF-Connecting-IPv6 "";
    proxy_set_header True-Client-IP "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_set_header Accept-Encoding identity;
    proxy_connect_timeout 3s;
    proxy_read_timeout 660s;
    proxy_send_timeout 660s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_next_upstream off;
    gzip off;
    add_header Cache-Control no-store always;
    add_header X-Content-Type-Options nosniff always;
}
