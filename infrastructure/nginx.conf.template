# Standalone nginx config. Replace api.example.invalid and certificate paths after owner review.
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/null;
events { worker_connections 1024; }
http {
    server_tokens off;
    access_log off;
    error_log /dev/null;
    autoindex off;
    client_max_body_size 262144;
    client_body_buffer_size 256k;
    client_header_buffer_size 1k;
    large_client_header_buffers 2 4k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 10s;
    keepalive_requests 100;
    reset_timedout_connection on;
    limit_req_zone $binary_remote_addr zone=gc_ip:1m rate=5r/s;
    limit_conn_zone $binary_remote_addr zone=gc_conn:1m;
    limit_conn_zone $server_name zone=gc_global:1m;
    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        server_name api.example.invalid;
        ssl_certificate /etc/ghostcloak/tls/fullchain.pem;
        ssl_certificate_key /etc/ghostcloak/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_session_tickets off;
        ssl_session_cache shared:TLS:1m;
        ssl_session_timeout 10m;
        if ($host != api.example.invalid) { return 421; }
        limit_req zone=gc_ip burst=20 nodelay;
        limit_req_status 429;
        limit_conn gc_conn 8;
        limit_conn gc_global 128;
        limit_conn_status 429;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control no-store always;
        location / {
            proxy_pass http://127.0.0.1:8787;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header CF-Connecting-IP "";
            proxy_set_header CF-Connecting-IPv6 "";
            proxy_set_header True-Client-IP "";
            proxy_set_header X-Real-IP "";
            proxy_set_header Forwarded "";
            proxy_set_header Connection "";
            proxy_connect_timeout 3s;
            proxy_read_timeout 15s;
            proxy_send_timeout 10s;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_next_upstream off;
        }
    }
}
