[Unit]
Description=Ghost Cloak outbound Cloudflare Tunnel connector
After=network-online.target ghostcloak-origin.service
Wants=network-online.target
Requires=ghostcloak-origin.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cloudflared
Group=cloudflared
SupplementaryGroups=ghostcloak-tunnel
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/ghostcloak.yml tunnel run
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
LimitNOFILE=4096
MemoryMax=512M
TasksMax=128
CPUQuota=100%
# No logfile/env/token/diagnostic streams. See LOGGING_POLICY.md for monitoring.
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
